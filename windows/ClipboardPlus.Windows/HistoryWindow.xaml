<Window x:Class="ClipboardPlus.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="clipboard+ 履歴" Width="360" Height="460"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="14"
        PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated">
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Margin="12,12,12,8">
        <TextBox x:Name="SearchBox" Padding="8,6" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                 Background="{DynamicResource Field}" Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                 TextChanged="OnSearchChanged"/>
        <TextBlock x:Name="SearchHint" Text="履歴を検索" Margin="11,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource Sub}" IsHitTestVisible="False"/>
      </Grid>

      <ListBox x:Name="HistoryList" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="8,0"
               Focusable="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
               PreviewMouseLeftButtonUp="OnListClick" PreviewMouseRightButtonDown="OnListRightDown">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Card" CornerRadius="8" Padding="10,8" Background="{DynamicResource Card}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Card" Property="Background" Value="{DynamicResource Hover}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Card" Property="Background" Value="{DynamicResource Selected}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Border Width="56" Height="42" CornerRadius="4" Margin="0,0,10,0" ClipToBounds="True"
                      Background="{DynamicResource Line}" Visibility="{Binding ThumbnailVisibility}">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
              </Border>
              <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                         Margin="2,2,12,0" Foreground="{DynamicResource Sub}" Visibility="{Binding FileIconVisibility}"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource Sub}" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="貼り付ける" Click="OnMenuPaste"/>
            <MenuItem Header="コピーだけする" Click="OnMenuCopy"/>
            <Separator/>
            <MenuItem Header="削除" Click="OnMenuDelete"/>
          </ContextMenu>
        </ListBox.ContextMenu>
      </ListBox>

      <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="28" TextWrapping="Wrap" TextAlignment="Center"
                 VerticalAlignment="Center" Foreground="{DynamicResource Sub}" Visibility="Collapsed"/>

      <Grid Grid.Row="2" Margin="12,4,6,8">
        <TextBlock Text="Enter 貼り付け　Ctrl+Enter コピー　Delete 削除" FontSize="11"
                   Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
        <Button Content="設定" HorizontalAlignment="Right" Padding="10,3" Cursor="Hand" Click="OnSettings"
                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}"/>
      </Grid>
    </Grid>
  </Border>
</Window>
