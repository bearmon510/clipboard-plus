<Window x:Class="ClipboardPlus.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="clipboard+ for Windows" Width="570" Height="690" MinWidth="500" MinHeight="460"
        Background="#F3F5F8" Foreground="#1F2937" FontFamily="Yu Gothic UI, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30,26">
      <TextBlock Text="clipboard+" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="iPhone・iPad と Windows を、近くで同期" Foreground="#64748B" Margin="0,2,0,22"/>
      <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="StatusText" Text="Bluetoothを確認しています" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="文章・リンク・画像・ファイルを、Bluetooth LEで両方向に送ります。" Foreground="#64748B" Margin="0,6,0,14" TextWrapping="Wrap"/>
          <TextBlock x:Name="TransferText" Foreground="#2E6BF0" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="最後に送った時刻" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="SentText" Text="まだありません" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="最後に受け取った時刻" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="ReceivedText" Text="まだありません" Margin="0,4,0,0"/></StackPanel>
          </Grid>
          <TextBlock Text="組んでいるiPhone・iPad" Foreground="#64748B" FontSize="12" Margin="0,14,0,0"/>
          <TextBlock x:Name="DevicesText" Text="まだ組んでいるiPhone・iPadはありません" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="22"/>
        </StackPanel>
      </Border>
      <Border Background="White" CornerRadius="12" Padding="20" Margin="0,16,0,18" BorderBrush="#E2E8F0" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="PairingTitle" Text="iPhone・iPadと組にする" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="iPhoneかiPadのclipboard+で、メニューの「設定」→「Windowsと同期」→「QRコードを読む」を選び、このコードを読んでください。1つのコードで、iPhoneとiPadの両方を組めます。" Margin="0,8,0,12" TextWrapping="Wrap"/>
          <Border Background="White" Padding="8" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          </Border>
          <TextBlock Text="このコードには組にするための鍵が含まれます。他の人に見せないでください。" FontSize="12" Foreground="#64748B" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
      <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,18" BorderBrush="#E2E8F0" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="履歴の窓" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="キーを押すと、PCとiPhone・iPadの履歴が開きます。選ぶと、元のアプリに貼り付けます。" Margin="0,8,0,12" TextWrapping="Wrap"/>
          <CheckBox x:Name="HotkeyCheck" Content="キーで履歴の窓を開く" Click="OnHotkeyEnabledChanged"/>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HotkeyText" Text="Win + V" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="RecordButton" Grid.Column="1" Content="キーを変える" Padding="10,4" Margin="8,0,0,0" Click="OnRecordHotkey"/>
            <Button x:Name="ResetHotkeyButton" Grid.Column="2" Content="Win + V に戻す" Padding="10,4" Margin="8,0,0,0" Click="OnResetHotkey"/>
          </Grid>
          <TextBlock x:Name="HotkeyMessage" Foreground="#B45309" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
          <CheckBox x:Name="PasteCheck" Content="選んだら、元のアプリに貼り付ける" Margin="0,12,0,0" Click="OnPasteChanged"/>
          <TextBlock Text="キーは、修飾キー（Win・Ctrl・Alt・Shift）とほかのキー1つの、2つで決めます。管理者として動いているアプリが手前にあるときは、Windowsの決まりでキーを受け取れず、Windowsの履歴が開きます。" FontSize="12" Foreground="#64748B" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <WrapPanel Margin="0,0,0,8">
        <WrapPanel.Resources>
          <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="10,4"/>
          </Style>
        </WrapPanel.Resources>
        <Button x:Name="HistoryButton" Content="履歴の窓を開く" Click="OnOpenHistory"/>
        <Button x:Name="RepairButton" Content="組み直す" Click="OnRepair"/>
        <Button x:Name="LogsButton" Content="ログのフォルダを開く" Click="OnOpenLogs"/>
      </WrapPanel>
      <CheckBox x:Name="StartupCheck" Content="Windowsの起動時に開く" Click="OnStartupChanged"/>
      <TextBlock Text="ウインドウを閉じても同期を続けます。終了するには、タスクトレイのアイコンから「終了」を選んでください。" FontSize="12" Foreground="#64748B" Margin="0,14,0,0"/>
      <Expander Header="Wi-Fi 転送の試験（段階A・開発用）" Foreground="#64748B" Margin="0,18,0,0">
        <Border Background="White" CornerRadius="12" Padding="18" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1" TextElement.Foreground="#1F2937">
          <StackPanel>
            <TextBlock Text="実機で一時Wi-FiとTCPの速度・許可ダイアログを確かめる試験用機能です（Bluetooth同期とはつながりません）。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <RadioButton x:Name="WifiProbeModeDirect" Content="Wi-Fi Direct（レガシー）" IsChecked="True" Margin="0,0,16,0"/>
              <RadioButton x:Name="WifiProbeModeHotspot" Content="モバイルホットスポット"/>
            </StackPanel>
            <WrapPanel Margin="0,12,0,0">
              <Button x:Name="WifiProbeStartButton" Content="試験を始める" Padding="12,5" Margin="0,0,8,0" Click="OnStartWifiProbe"/>
              <Button x:Name="WifiProbeStopButton" Content="試験を終える" Padding="12,5" IsEnabled="False" Click="OnStopWifiProbe"/>
            </WrapPanel>
            <TextBlock x:Name="WifiProbeStatusText" Text="まだ始めていません。" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="WifiProbeErrorText" Foreground="#B45309" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            <StackPanel x:Name="WifiProbeQrPanel" Margin="0,12,0,0" Visibility="Collapsed">
              <Border Background="White" Padding="6" HorizontalAlignment="Center" BorderBrush="#E2E8F0" BorderThickness="1">
                <Image x:Name="WifiProbeQrImage" Width="210" Height="210" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
              </Border>
              <TextBlock Text="iPhone・iPadの「設定」→「Wi-Fi 転送の試験」からこのQRコードを読んでください。終わったら「試験を終える」で一時Wi-Fiを止めます。" FontSize="12" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Name="WifiProbeTimelineText" FontFamily="Consolas, Yu Gothic UI" FontSize="12" Foreground="#334155" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Window>
